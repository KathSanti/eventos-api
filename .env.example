# Copia este archivo a ".env" (sin .example) y pon tus propios valores.
# ".env" nunca se sube a git (ver .gitignore) - estas son solo las claves
# que esperan docker-compose.yml (local) y docker-compose.prod.yml (EC2).
# Los mismos nombres son los Secrets que vas a crear en GitHub Actions.

# --- Solo para docker-compose.prod.yml (imagen publicada en Docker Hub) ---
DOCKERHUB_USERNAME=tu_usuario_dockerhub
IMAGE_NAME=eventos-api

# --- Base de datos ---
DB_NAME=eventos_db
# En produccion NO uses "root": MySQL no permite crear un usuario llamado root
# con MYSQL_USER. Usa un nombre propio, por ejemplo eventos_app.
DB_USER=eventos_app
DB_PASSWORD=cambia-esta-clave
# Clave del usuario root de MySQL (solo produccion; distinta de DB_PASSWORD)
DB_ROOT_PASSWORD=cambia-esta-otra-clave

# --- Administrador inicial de la API ---
ADMIN_EMAIL=admin@eventos.com
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NOMBRE=Administrador

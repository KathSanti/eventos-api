                "eventos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Evento sin permiso\",\n  \"fecha\": \"2026-12-31\",\n  \"precio\": 10000\n}",
